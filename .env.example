# Supabase Configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=["https://gotravyl.com", "https://dev.gotravyl.com", "http://localhost:3000"]

# AWS Configuration
# For local dev: set AWS_BEARER_TOKEN (Bedrock API key)
# On EC2: credentials come from IAM role automatically
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
AWS_BEARER_TOKEN=

# Budget tier base rates (USD/day before cost-of-living adjustment)
BUDGET_BASE_USD=45
MODERATE_BASE_USD=105
COMFORTABLE_BASE_USD=225
LUXURY_BASE_USD=400
